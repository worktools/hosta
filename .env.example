# Optional. Without this key Hosta uses a visibly labelled local demo generator.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
PORT=4173

# Independent Hoya execution v1 (required for all execution paths)
HOYA_URL=http://127.0.0.1:3000
HOYA_AUTH_TOKEN=
# Optional management API authentication; also used by the CLI
HOSTA_API_TOKEN=
# Trusted local source compilation only; prefer uploading precompiled WASM
HOSTA_ENABLE_LOCAL_COMPILER=0
